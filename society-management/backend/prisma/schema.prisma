generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  role Role @default(RESIDENT)

  createdAt DateTime @default(now())

  societyId Int?

  society Society? @relation(fields: [societyId], references: [id])

  complaints Complaint[]

  maintenances Maintenance[]

  bookings Booking[]

  payments Payment[]
   kyc KYC?
}

model Society {
  id Int @id @default(autoincrement())

  name String

  address String

  city String

  createdAt DateTime @default(now())

  users User[]

  complaints Complaint[]

  flats Flat[]

  notices Notice[]

  subscriptions Subscription?
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RESIDENT
  TENANT
  GUARD
  ACCOUNTANT
  
}

model Complaint {
  id Int @id @default(autoincrement())

  title       String
  description String

  image String?

  assignedStaff String?
  feedback      String?
  rating        Int?
  resolvedAt    DateTime?
  status        String    @default("OPEN")

  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  societyId Int
  society   Society @relation(fields: [societyId], references: [id])
}

model Flat {

  id Int @id @default(autoincrement())

  block String

  flatNo String

  floor String @default("")

  ownerName String @default("")

  occupancyStatus String @default("VACANT")

  societyId Int

  society Society @relation(fields:[societyId], references:[id])
}

model Visitor {
  id Int @id @default(autoincrement())

  name String

  phone String

  purpose String?

  vehicleNumber String?

  deliveryType String?

  qrCode String?

  status String @default("PENDING")

  checkIn DateTime?

  checkOut DateTime?

  createdAt DateTime @default(now())
}

model ActivityLog {
  id Int @id @default(autoincrement())

  action String

  userId Int

  userName String

  createdAt DateTime @default(now())
}

model Subscription {
  id Int @id @default(autoincrement())

  plan String

  price Float

  startDate DateTime

  endDate DateTime

  societyId Int @unique

  society Society @relation(fields: [societyId], references: [id])
}

model Vendor {
  id        Int       @id @default(autoincrement())
  name      String
  service   String
  phone     String
  address   String
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  category  String
  vendorId  Int?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())
}

model Maintenance {
  id Int @id @default(autoincrement())

  amount Float

  month String

  status String @default("PENDING")

  lateFee Float @default(0)

  gst Float @default(0)

  total Float

  dueDate DateTime

  createdAt DateTime @default(now())

  userId Int

  user User @relation(fields: [userId], references: [id])
}

model Booking {
  id Int @id @default(autoincrement())

  amenity String

  date DateTime

  slot String

  status String @default("PENDING")

  createdAt DateTime @default(now())

  userId Int

  user User @relation(fields: [userId], references: [id])
}

model Notice {
  id Int @id @default(autoincrement())

  title String

  message String

  createdAt DateTime @default(now())

  societyId Int

  society Society @relation(fields: [societyId], references: [id])
}

model Payment {
  id                Int      @id @default(autoincrement())
  userId            Int
  amount            Float
  waterCharge       Float
  electricityCharge Float
  lateFee           Float
  totalAmount       Float
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
model ParkingSlot {
  id Int @id @default(autoincrement())

  slotNumber String

  status String @default("AVAILABLE")

  flatId Int?

  createdAt DateTime @default(now())
}
model KYC {

  id Int @id @default(autoincrement())

  citizenship String?

  passport String?

  profilePhoto String?

  documentUrl String?

  userId Int @unique

  user User @relation(fields:[userId], references:[id])

  createdAt DateTime @default(now())
}